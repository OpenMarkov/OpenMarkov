<?xml version="1.0" encoding="UTF-8"?>
<ProbModelXML formatVersion="1.0.0">
  <ProbNet type="DAN">
    <Comment showWhenOpeningNetwork="true"><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
      Decision analysis network for total knee arthroplasty, i.e., for 
      deciding whether the knee should be replaced with a prosthesis, 
      depending on the body mass index and the possible presence of diabetes 
      and antibiotic allergy.
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      Adapted by F. J. D&#237;ez from the influence diagram built by Diego Le&#243;n in 
      collaboration with Rub&#233;n Garc&#237;a-Fraile (orthopedic surgeon) and F. J. 
      D&#237;ez and Manuel Luque (supervisors).
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      <b>Reference</b>
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      D. Le&#243;n Guerra. <i><a href="http://www.cisiad.uned.es/tesis/master-thesis-dleon.php">A 
      Probabilistic Graphical Model for Total Knee Arthroplasty</a></i>. 
      Master Thesis, Dept. Artificial Intelligence, UNED, Madrid, Spain, 2011.
    </p>
  </body>
</html>
