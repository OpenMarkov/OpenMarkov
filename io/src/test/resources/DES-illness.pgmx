<?xml version="1.0" encoding="UTF-8"?>
<!--
  El modelo de sucesos discretos con que se mide el motor de la simulación, escrito a fichero.

  Es el mismo que `tst_des.cpp` construye a mano y el mismo que `tools/parity/DesSimulated.java`
  construye en Java, nodo por nodo. Está aquí porque **ninguna red del corpus es de sucesos** —ni
  aquí ni en el repositorio Java, donde no hay un solo `.pgmx` de esa clase—, así que sin él no hay
  manera de abrir un modelo de esa clase ni de recorrer el camino entero desde el menú.

  Lo escribió el propio escritor de este porte, y las dos versiones lo leen igual: jugado desde el
  fichero contesta lo mismo, bit a bit, que jugado desde el modelo construido a mano, y el Java
  contesta lo mismo leyéndolo que construyéndolo.

  Una terapia que retrasa el comienzo de una enfermedad; un comienzo que deja al paciente enfermo
  para siempre; una revisión que se vuelve a citar a sí misma —para eso está el lazo—; una muerte
  cuyo plazo depende de estar enfermo y que acaba el recorrido; y cinco cosas que se cuentan.
-->
<ProbModelXML formatVersion="1.0.0">
  <ProbNet type="DESNet">
    <DecisionCriteria>
      <Criterion name="cost" unit="€"/>
      <Criterion name="effectiveness" unit="QALY"/>
    </DecisionCriteria>
    <TimeUnit Value="1.0" unit="YEAR"/>
    <Variables>
      <Variable name="Therapy" role="decision" type="finiteStates">
        <Coordinates x="60" y="60"/>
        <States>
          <State name="none"/>
          <State name="drug"/>
        </States>
      </Variable>
      <Variable name="Sex" role="chance" type="finiteStates">
        <Coordinates x="60" y="200"/>
        <States>
          <State name="male"/>
          <State name="female"/>
        </States>
      </Variable>
      <Variable name="Onset" role="event" type="event">
        <Coordinates x="260" y="130"/>
        <AdditionalProperties>
          <Property name="AlwaysAppend" value="false"/>
        </AdditionalProperties>
        <Unit></Unit>
        <Precision>0.0</Precision>
      </Variable>
      <Variable name="Ill" role="chance" type="finiteStates">
        <Coordinates x="440" y="130"/>
        <States>
          <State name="no"/>
          <State name="yes"/>
        </States>
      </Variable>
      <Variable name="Checkup" role="event" type="event">
        <Coordinates x="260" y="280"/>
        <AdditionalProperties>
          <Property name="AlwaysAppend" value="false"/>
        </AdditionalProperties>
        <Unit></Unit>
        <Precision>0.0</Precision>
      </Variable>
      <Variable name="Death" role="event" type="event">
        <Coordinates x="620" y="130"/>
        <AdditionalProperties>
          <Property name="Purpose" value="terminalEvent"/>
          <Property name="AlwaysAppend" value="false"/>
        </AdditionalProperties>
        <Unit></Unit>
        <Precision>0.0</Precision>
      </Variable>
      <Variable name="QALY" role="utility" type="numeric">
        <Coordinates x="440" y="300"/>
        <Unit></Unit>
        <Precision>0.0</Precision>
        <Criterion name="effectiveness"/>
      </Variable>
      <Variable name="CareCost" role="utility" type="numeric">
        <Coordinates x="600" y="300"/>
        <Unit></Unit>
        <Precision>0.0</Precision>
        <Criterion name="cost"/>
      </Variable>
      <Variable name="Monitoring" role="utility" type="numeric">
        <Coordinates x="60" y="380"/>
        <Unit></Unit>
        <Precision>0.0</Precision>
        <Criterion name="cost"/>
      </Variable>
      <Variable name="TreatmentCost" role="utility" type="numeric">
        <Coordinates x="260" y="400"/>
        <Unit></Unit>
        <Precision>0.0</Precision>
        <Criterion name="cost"/>
      </Variable>
      <Variable name="CheckupCost" role="utility" type="numeric">
        <Coordinates x="440" y="420"/>
        <Unit></Unit>
        <Precision>0.0</Precision>
        <Criterion name="cost"/>
      </Variable>
    </Variables>
    <Links>
      <Link directed="true">
        <Variable name="Therapy"/>
        <Variable name="Onset"/>
      </Link>
      <Link directed="true">
        <Variable name="Therapy"/>
        <Variable name="Monitoring"/>
      </Link>
      <Link directed="true">
        <Variable name="Therapy"/>
        <Variable name="TreatmentCost"/>
      </Link>
      <Link directed="true">
        <Variable name="Sex"/>
        <Variable name="Onset"/>
      </Link>
      <Link directed="true">
        <Variable name="Onset"/>
        <Variable name="Ill"/>
      </Link>
      <Link directed="true">
        <Variable name="Onset"/>
        <Variable name="Checkup"/>
      </Link>
      <Link directed="true">
        <Variable name="Onset"/>
        <Variable name="Death"/>
      </Link>
      <Link directed="true">
        <Variable name="Onset"/>
        <Variable name="TreatmentCost"/>
      </Link>
      <Link directed="true">
        <Variable name="Ill"/>
        <Variable name="Death"/>
      </Link>
      <Link directed="true">
        <Variable name="Ill"/>
        <Variable name="QALY"/>
      </Link>
      <Link directed="true">
        <Variable name="Ill"/>
        <Variable name="CareCost"/>
      </Link>
      <Link directed="true">
        <Variable name="Checkup"/>
        <Variable name="Checkup"/>
      </Link>
      <Link directed="true">
        <Variable name="Checkup"/>
        <Variable name="CheckupCost"/>
      </Link>
    </Links>
    <Potentials>
      <Potential type="Table">
        <Variables>
          <Variable name="Sex"/>
        </Variables>
        <Values>0.5 0.5 </Values>
      </Potential>
      <Potential type="DistributionTable">
        <Variables>
          <Variable name="Onset"/>
          <Variable name="Therapy"/>
          <Variable name="Sex"/>
        </Variables>
        <Value distribution="Exact" parametrization="Nu"/>
        <Values>2.0 5.0 3.0 6.0 </Values>
      </Potential>
      <Potential type="TransitionTable">
        <Variables>
          <Variable name="Ill"/>
          <Variable name="Onset"/>
        </Variables>
        <Values>0.0 1.0 </Values>
      </Potential>
      <Potential type="DistributionTable">
        <Variables>
          <Variable name="Checkup"/>
          <Variable name="Onset"/>
          <Variable name="Checkup"/>
        </Variables>
        <Value distribution="Exact" parametrization="Nu"/>
        <Values>1.2 1.2 </Values>
      </Potential>
      <Potential type="DistributionTable">
        <Variables>
          <Variable name="Death"/>
          <Variable name="Onset"/>
          <Variable name="Ill"/>
        </Variables>
        <Value distribution="Exact" parametrization="Nu"/>
        <Values>8.0 3.0 </Values>
      </Potential>
      <Potential distribution="Exact" type="UnivariateDistr">
        <Variables>
          <Variable name="QALY"/>
          <Variable name="Ill"/>
        </Variables>
        <Values>1.0 0.6 </Values>
      </Potential>
      <Potential distribution="Exact" type="UnivariateDistr">
        <Variables>
          <Variable name="CareCost"/>
          <Variable name="Ill"/>
        </Variables>
        <Values>100.0 2000.0 </Values>
      </Potential>
      <Potential distribution="Exact" type="UnivariateDistr">
        <Variables>
          <Variable name="Monitoring"/>
          <Variable name="Therapy"/>
        </Variables>
        <Values>10.0 40.0 </Values>
      </Potential>
      <Potential distribution="Exact" type="UnivariateDistr">
        <Variables>
          <Variable name="TreatmentCost"/>
          <Variable name="Therapy"/>
        </Variables>
        <Values>0.0 500.0 </Values>
      </Potential>
      <Potential type="Delta">
        <Variables>
          <Variable name="CheckupCost"/>
        </Variables>
        <NumericValue>30.0</NumericValue>
      </Potential>
    </Potentials>
  </ProbNet>
  <InferenceOptions>
    <MulticriteriaOptions>
      <SelectedAnalysisType>UNICRITERION</SelectedAnalysisType>
      <Unicriterion>
        <Scales>
          <Scale Criterion="cost" Value="1.0"/>
          <Scale Criterion="effectiveness" Value="1.0"/>
        </Scales>
      </Unicriterion>
      <CostEffectiveness>
        <Scales>
          <Scale Criterion="cost" Value="1.0"/>
          <Scale Criterion="effectiveness" Value="1.0"/>
        </Scales>
        <CE_Criteria>
          <CE_Criterion Criterion="cost" Value="Cost"/>
          <CE_Criterion Criterion="effectiveness" Value="Effectiveness"/>
        </CE_Criteria>
      </CostEffectiveness>
    </MulticriteriaOptions>
    <TemporalOptions>
      <Slices>7</Slices>
      <Transition>BEGINNING</Transition>
      <DiscountRates>
        <DiscountRate Criterion="cost" unit="YEAR" value="0.03"/>
        <DiscountRate Criterion="effectiveness" unit="YEAR" value="0.0"/>
      </DiscountRates>
    </TemporalOptions>
    <MonteCarlo>
      <NumberOfSimulations>3</NumberOfSimulations>
      <NumberOfSeries>2</NumberOfSeries>
    </MonteCarlo>
  </InferenceOptions>
  <DefaultStates>
    <State name="absent"/>
    <State name="present"/>
  </DefaultStates>
</ProbModelXML>
