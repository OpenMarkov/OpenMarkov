          <State name="yes" />
        </States>
      </Variable>
      <Variable name="Transition" timeSlice="1" type="finiteStates" role="chance">
        <Comment><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
      Transition between live states, either from <i>CD4% &lt; 8</i> to <i>CD4% 8&#8211;15</i> 
      of from <i>CD4% 8&#8211;15</i> to <i>CD4% &gt; 15</i>.
    </p>
  </body>
</html>]]></Comment>
