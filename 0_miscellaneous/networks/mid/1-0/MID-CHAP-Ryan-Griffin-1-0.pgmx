<?xml version="1.0" encoding="UTF-8"?>
<ProbModelXML formatVersion="1.0.0">
  <ProbNet type="MID">
    <Comment showWhenOpeningNetwork="true"><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
      MID for analyzing the cost-effectiveness of HIV prophylaxis in children.
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      Reference:
    </p>
    <p style="margin-top: 0">
      Ryan M, Griffin S, Chitah B, et al.
    </p>
    <p style="margin-top: 0">
      The cost-effectiveness of cotrimoxazole prophylaxis in HIV-infected 
      children in Zambia.
    </p>
    <p style="margin-top: 0">
      <i>AIDS</i> 2008,22:749&#8211;757.
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      MID built by I&#241;igo Bermejo and F. Javier D&#237;ez in July 2013, based on 
      the Excel+R model built by Ryan et al.
    </p>
    <p style="margin-top: 0">
      
    </p>
    <p style="margin-top: 0">
      Open the properties dialog of each node to obtain additional 
      information. See also the chapter on MIDs in <a href="http://www.openmarkov.org/docs/tutorial">OpenMarkov's 
      tutorial</a>.
    </p>
  </body>
</html>
<!--StartFragment-->]]></Comment>
    <DecisionCriteria>
      <Criterion name="cost" unit="£" />
      <Criterion name="effectiveness" unit="QALY" />
    </DecisionCriteria>
    <TimeUnit unit="YEAR" Value="1.0" />
    <Variables>
      <Variable name="Age" timeSlice="0" type="numeric" role="chance">
        <Coordinates x="527" y="34" />
        <Unit />
        <Precision>1.0</Precision>
        <Thresholds>
          <Threshold value="0.0" belongsTo="right" />
          <Threshold value="Infinity" belongsTo="right" />
        </Thresholds>
      </Variable>
      <Variable name="State" timeSlice="0" type="finiteStates" role="chance">
        <Comment><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
      The state is defined as a function of the CD4%. Ryan et al. &quot;prefer CD4% 
      over CD4 cell count as a predictive marker because of the rapid natural 
      reduction in CD4 cell count with increasing age in uninfected young 
      children.&quot;
    </p>
  </body>
</html>]]></Comment>
        <Coordinates x="327" y="205" />
        <States>
          <State name="dead" />
          <State name="CD4% &lt; 8" />
          <State name="CD4% 8–15" />
          <State name="CD4% &gt; 15" />
        </States>
      </Variable>
      <Variable name="State" timeSlice="1" type="finiteStates" role="chance">
        <Coordinates x="864" y="205" />
        <States>
          <State name="dead" />
          <State name="CD4% &lt; 8" />
          <State name="CD4% 8–15" />
          <State name="CD4% &gt; 15" />
        </States>
      </Variable>
      <Variable name="Death" timeSlice="1" type="finiteStates" role="chance">
        <Comment><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
