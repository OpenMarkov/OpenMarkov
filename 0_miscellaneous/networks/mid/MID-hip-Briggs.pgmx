          <State name="successful revised" />
          <State name="revision THR" />
          <State name="successful primary" />
          <State name="primary THR" />
        </States>
      </Variable>
      <Variable name="Age" timeSlice="0" type="numeric" role="chance">
        <Comment><![CDATA[<html>
  <head>
    
  </head>
  <body>
    <p style="margin-top: 0">
      Age at the first cycle. It is the same as the age at entry.
    </p>
  </body>
</html>]]></Comment>
