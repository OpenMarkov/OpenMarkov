<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openmarkov</groupId>
        <artifactId>OpenMarkov</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>
    <artifactId>full</artifactId>
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd_HH-mm-ss</maven.build.timestamp.format>
        <!-- The version the installers show to the user. It is kept apart from ${project.version}
             because jpackage rejects any version carrying a suffix such as -SNAPSHOT. -->
        <installer.app.version>0.3</installer.app.version>
        <!-- Every installer format jpackage produces is tied to the operating system it runs on:
             msi and exe exist only on Windows, deb and rpm only on Linux. The Installer profile
             therefore skips them all by default, and each detect-* profile below turns off the
             skipping of the formats its own operating system can build. -->
        <skip.installer.windows>true</skip.installer.windows>
        <skip.installer.linux>true</skip.installer.linux>
        <!-- The portable application image is the one format jpackage builds anywhere, so it is
             enabled on both Windows and Linux. It stays skipped on macOS, whose icon format
             (icns) is not in the repository and which nobody in the team can test on. -->
        <skip.installer.portable>true</skip.installer.portable>
        <!-- Outside Windows jpackage only accepts a PNG icon: given the ico file it stops with an
             error and leaves the application image half built. -->
        <installer.icon>${maven.multiModuleProjectDirectory}/gui/src/main/resources/icons/openmarkov.png</installer.icon>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>gui</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>costEffectiveness</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>sensitivityAnalysis</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>dbGenerator</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>bnEvaluation</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>stochasticPropagationOutput</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>io</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>learning.algorithm</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>learning.gui</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>learning.metric</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openmarkov</groupId>
            <artifactId>inference</artifactId>
            <version>0.3.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>
        </plugins>
    </reporting>
    <profiles>
        <profile>
            <id>detect-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <skip.installer.windows>false</skip.installer.windows>
                <skip.installer.portable>false</skip.installer.portable>
                <installer.icon>${maven.multiModuleProjectDirectory}/gui/src/main/resources/icons/openmarkov.ico</installer.icon>
            </properties>
        </profile>
        <profile>
            <id>detect-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <skip.installer.linux>false</skip.installer.linux>
                <skip.installer.portable>false</skip.installer.portable>
            </properties>
        </profile>
        <profile>
            <id>Installer</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>com.github.akman</groupId>
                            <artifactId>jpackage-maven-plugin</artifactId>
                            <version>0.1.5</version>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <!-- To create the installers a few steps are required prior to creating the msi or exe files -->
                <plugins>
                    <!-- Step 1. Copy all dependencies into target/libs -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Step 2. Copy the main module's own JAR into target/libs -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                        </configuration>
                    </plugin>
                    <!-- Step 3. Run jpackage to generate the intallers -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <!-- Each execution decides on its own whether to run, because each format
                             belongs to a different operating system. Skipping the plugin as a
                             whole, as was done before, also threw away the portable application
                             image, which jpackage can perfectly well build outside Windows. -->
                        <executions>
                            <execution>
                                <id>create-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.installer.windows}</skip>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--name</argument>
                                        <argument>OpenMarkov</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.app.version}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) CISIAD, UNED, Spain, 2026. Licensed under the GPLv3
                                            licence.
                                        </argument>
                                        <argument>--description</argument>
                                        <argument>An open-source software tool for probabilistic graphical models (PGMs)
                                            developed by the Research Centre for Intelligent Decision-Support Systems of
                                            the UNED in Madrid, Spain.
                                        </argument>
                                        <argument>--vendor</argument>
                                        <argument>CISIAD, UNED</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.openmarkov.full.OpenMarkov</argument>
                                        <argument>--icon</argument>
                                        <argument>${installer.icon}</argument>
                                        <argument>--license-file</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/LICENSE</argument>
                                        <argument>--about-url</argument>
                                        <argument>https://www.openmarkov.org/</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--file-associations</argument>
                                        <argument>${project.basedir}/associations/pgmx.properties</argument>
                                        <!--<argument>&#45;&#45;win-console</argument>-->
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>create-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.installer.windows}</skip>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--name</argument>
                                        <argument>OpenMarkov</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.app.version}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) CISIAD, UNED, Spain, 2026. Licensed under the GPLv3
                                            licence.
                                        </argument>
                                        <argument>--description</argument>
                                        <argument>An open-source software tool for probabilistic graphical models (PGMs)
                                            developed by the Research Centre for Intelligent Decision-Support Systems of
                                            the UNED in Madrid, Spain.
                                        </argument>
                                        <argument>--vendor</argument>
                                        <argument>CISIAD, UNED</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.openmarkov.full.OpenMarkov</argument>
                                        <argument>--icon</argument>
                                        <argument>${installer.icon}</argument>
                                        <argument>--license-file</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/LICENSE</argument>
                                        <argument>--about-url</argument>
                                        <argument>https://www.openmarkov.org/</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--file-associations</argument>
                                        <argument>${project.basedir}/associations/pgmx.properties</argument>
                                        <!--<argument>&#45;&#45;win-console</argument>-->
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>create-portable</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.installer.portable}</skip>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--name</argument>
                                        <argument>OpenMarkov</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.app.version}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) CISIAD, UNED, Spain, 2026. Licensed under the GPLv3
                                            licence.
                                        </argument>
                                        <argument>--description</argument>
                                        <argument>An open-source software tool for probabilistic graphical models (PGMs)
                                            developed by the Research Centre for Intelligent Decision-Support Systems of
                                            the UNED in Madrid, Spain.
                                        </argument>
                                        <argument>--vendor</argument>
                                        <argument>CISIAD, UNED</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.openmarkov.full.OpenMarkov</argument>
                                        <argument>--icon</argument>
                                        <argument>${installer.icon}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- The deb package covers Debian, Ubuntu and their derivatives; it
                                 needs the fakeroot and dpkg-deb programs on the machine that
                                 builds it. The package name has to be lower case, since Debian
                                 does not allow capitals in it, while the application keeps its
                                 own name. -->
                            <execution>
                                <id>create-deb</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.installer.linux}</skip>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>deb</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--name</argument>
                                        <argument>OpenMarkov</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.app.version}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) CISIAD, UNED, Spain, 2026. Licensed under the GPLv3
                                            licence.
                                        </argument>
                                        <argument>--description</argument>
                                        <argument>An open-source software tool for probabilistic graphical models (PGMs)
                                            developed by the Research Centre for Intelligent Decision-Support Systems of
                                            the UNED in Madrid, Spain.
                                        </argument>
                                        <argument>--vendor</argument>
                                        <argument>CISIAD, UNED</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.openmarkov.full.OpenMarkov</argument>
                                        <argument>--icon</argument>
                                        <argument>${installer.icon}</argument>
                                        <argument>--license-file</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/LICENSE</argument>
                                        <argument>--about-url</argument>
                                        <argument>https://www.openmarkov.org/</argument>
                                        <argument>--file-associations</argument>
                                        <argument>${project.basedir}/associations/pgmx.properties</argument>
                                        <argument>--linux-package-name</argument>
                                        <argument>openmarkov</argument>
                                        <argument>--linux-deb-maintainer</argument>
                                        <argument>openmarkov-users@googlegroups.com</argument>
                                        <argument>--linux-menu-group</argument>
                                        <argument>Science</argument>
                                        <argument>--linux-app-category</argument>
                                        <argument>science</argument>
                                        <argument>--linux-shortcut</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- The rpm package covers Red Hat, Fedora, openSUSE and their
                                 derivatives; it needs the rpm-build package on the machine that
                                 builds it. It differs from the deb one in the licence type, which
                                 rpm records in its own field, and in having no maintainer field. -->
                            <execution>
                                <id>create-rpm</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.installer.linux}</skip>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>rpm</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--name</argument>
                                        <argument>OpenMarkov</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.app.version}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) CISIAD, UNED, Spain, 2026. Licensed under the GPLv3
                                            licence.
                                        </argument>
                                        <argument>--description</argument>
                                        <argument>An open-source software tool for probabilistic graphical models (PGMs)
                                            developed by the Research Centre for Intelligent Decision-Support Systems of
                                            the UNED in Madrid, Spain.
                                        </argument>
                                        <argument>--vendor</argument>
                                        <argument>CISIAD, UNED</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.openmarkov.full.OpenMarkov</argument>
                                        <argument>--icon</argument>
                                        <argument>${installer.icon}</argument>
                                        <argument>--license-file</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/LICENSE</argument>
                                        <argument>--about-url</argument>
                                        <argument>https://www.openmarkov.org/</argument>
                                        <argument>--file-associations</argument>
                                        <argument>${project.basedir}/associations/pgmx.properties</argument>
                                        <argument>--linux-package-name</argument>
                                        <argument>openmarkov</argument>
                                        <argument>--linux-rpm-license-type</argument>
                                        <argument>GPLv3</argument>
                                        <argument>--linux-menu-group</argument>
                                        <argument>Science</argument>
                                        <argument>--linux-app-category</argument>
                                        <argument>science</argument>
                                        <argument>--linux-shortcut</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>GenerateFullJar</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-assembly-plugin</artifactId>
                            <version>3.6.0</version>
                            <configuration>
                                <outputDirectory>${project.basedir}/..</outputDirectory>
                                <finalName>OpenMarkov-${maven.build.timestamp}</finalName>
                                <!--                        <finalName>OpenMarkov-${maven.build.timestamp}</finalName>-->
                                <finalName>OpenMarkov</finalName>
                                <appendAssemblyId>false</appendAssemblyId>
                                <attach>false</attach>
                                <descriptorRefs>
                                    <descriptorRef>jar-with-dependencies</descriptorRef>
                                </descriptorRefs>
                                <archive>
                                    <manifest>
                                        <mainClass>org.openmarkov.full.OpenMarkov</mainClass>
                                    </manifest>
                                </archive>
                                <appendAssemblyId>false</appendAssemblyId>
                                <encoding>UTF-8</encoding>
                            </configuration>
                            <executions>
                                <execution><!-- MLUQUE: I do not know if this block is necessary -->
                                    <id>make-assembly</id> <!-- this is used for inheritance merges -->
                                    <phase>package</phase> <!-- bind to the packaging phase -->
                                    <goals>
                                        <goal>single</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>