#!/bin/sh

# The slow tests are left out so that this stays under a minute: it runs on every
# single commit, and a hook people wait for is a hook people bypass. Continuous
# integration runs "mvn test --batch-mode" with no exclusion on every push to
# development, so nothing stops being checked - it is checked a bit later.
#
# Excluding speed_slow takes this from about 1860 tests in 54 seconds to about
# 1700 in 33. To run everything here: mvn test --batch-mode
mvn test --batch-mode -DexcludedGroups=speed_slow